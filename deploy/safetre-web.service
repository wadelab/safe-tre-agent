# Hardened systemd unit for the safe-tre-agent web interface.
# Install: copy to /etc/systemd/system/, run `uv sync --all-extras` in WorkingDirectory
# first (creates .venv), then: systemctl daemon-reload && systemctl enable --now safetre-web
#
# The sandboxing directives are the security boundary at the process level;
# `systemd-analyze security safetre-web` should report a low exposure score.

[Unit]
Description=safe-tre-agent — TRE safe-outputs gateway (web)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/probox/raid/toolbox/git/safe-tre-agent
Environment=PYTHONPATH=/probox/raid/toolbox/git/safe-tre-agent
Environment=SAFETRE_LLM=mock
Environment=SAFETRE_AUDIT_DB=/var/lib/safetre/audit.db
# bind localhost only; expose via `tailscale serve --bg 8800`
ExecStart=/probox/raid/toolbox/git/safe-tre-agent/.venv/bin/uvicorn safetre_web.app:app --host 127.0.0.1 --port 8800

# --- least-privilege sandboxing ---
DynamicUser=yes
StateDirectory=safetre
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=1G
TasksMax=64

[Install]
WantedBy=multi-user.target
