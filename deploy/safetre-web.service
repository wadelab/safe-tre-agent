# Hardened systemd unit for the safe-tre-agent web interface.
# Install: adjust the /opt/safe-tre-agent paths to your checkout, copy to
# /etc/systemd/system/, run `uv sync --all-extras` in WorkingDirectory
# first (creates .venv), then: systemctl daemon-reload && systemctl enable --now safetre-web
#
# The sandboxing directives are the security boundary at the process level;
# `systemd-analyze security safetre-web` should report a low exposure score.

[Unit]
Description=safe-tre-agent — TRE safe-outputs gateway (web)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/safe-tre-agent
Environment=PYTHONPATH=/opt/safe-tre-agent
# Real local model (no data egress). The IPAddress* sandbox below permits only
# loopback, so this must point at an in-safepod model, not a remote provider.
# Point BASE_URL/MODEL at your served model; keep it local to preserve no-egress.
Environment=SAFETRE_LLM=real
Environment=SAFETRE_LLM_BASE_URL=http://127.0.0.1:8000/v1
Environment=SAFETRE_LLM_MODEL=local-120b
Environment=SAFETRE_AUDIT_DB=/var/lib/safetre/audit.db
Environment=SAFETRE_REQUIRE_IDENTITY=1
Environment=SAFETRE_RESTRICTED_CHANNEL=1
Environment=SAFETRE_CHANNEL_ALLOW_NETS=127.0.0.1/32,::1/128
# --- Safe People: BOTH of the next two are required in production ------------
# The model runtime above listens on loopback and is UNTRUSTED by the threat
# model, so "only the proxy can reach the socket" is false and the identity
# header alone proves nothing. `tailscale serve` must inject the shared secret
# (it is the one measure verified to refuse a forged header), and the allowlist
# is the Safe People gate. Without them the app fails closed and logs why
# (safetre_web/identity.py, hardening #45).
#
# Generate once, keep OFF this host's repo, and load from an EnvironmentFile
# that is not world-readable:
#   install -m 0600 /dev/null /etc/safetre/proxy.env
#   printf 'SAFETRE_PROXY_SHARED_SECRET=%s\n' "$(openssl rand -hex 32)" \
#     >> /etc/safetre/proxy.env
EnvironmentFile=/etc/safetre/proxy.env
Environment=SAFETRE_ALLOWLIST=researcher@example.ac.uk
# --- audit chain: the key must NOT be derivable from this host alone ---------
# The chain is HMAC-keyed so that someone who can REWRITE the database cannot
# forge it. Without SAFETRE_AUDIT_KEY the app generates a key beside the log
# (0600) — which means a host compromise holds the log AND the key and can
# re-MAC a chain that verify() accepts, defeating the whole control. This unit
# used to set the database path and not the key, and startup only warned; it
# now refuses to start (hardening #65).
#
# Generate once, keep it off this host's repo and off the state directory that
# holds audit.db, and load it the same way as the proxy secret:
#   install -m 0600 /dev/null /etc/safetre/audit.env
#   printf 'SAFETRE_AUDIT_KEY=%s\n' "$(openssl rand -hex 32)" \
#     >> /etc/safetre/audit.env
#
# Being honest about what this buys on a single host: /etc and /var/lib are the
# same disk, so an attacker with root still reaches both. What it defeats is the
# weaker and likelier case — write access to the state directory, a restored or
# copied audit.db, a backup — and it makes the key a thing an operator can
# rotate and store elsewhere. The control that survives full host compromise is
# the off-box ANCHOR below: publish the chain head somewhere this machine cannot
# write, and a wholesale rewrite stops verifying however good the forgery is.
EnvironmentFile=/etc/safetre/audit.env
# The last known-good chain head, recorded off-box (a log line to a remote
# collector, a note in the operations record — anywhere this host cannot edit).
# /api/audit/verify checks the recomputed head against it, and rehydration
# refuses to rebuild the session controls from a chain that does not match
# (hardening #59). Update it whenever you record a new head.
#Environment=SAFETRE_AUDIT_HEAD_ANCHOR=<64-hex chain head from /api/audit/verify>
# bind localhost only; expose via `tailscale serve --bg 8800`
ExecStart=/opt/safe-tre-agent/.venv/bin/uvicorn safetre_web.app:app --host 127.0.0.1 --port 8800

# --- least-privilege sandboxing ---
DynamicUser=yes
StateDirectory=safetre
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=1G
TasksMax=64

[Install]
WantedBy=multi-user.target
