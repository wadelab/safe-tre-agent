# Copy to .env. Offline (MockLLM) needs none of this.
# The client is OpenAI-compatible, so any of these backends work by config:

# --- OpenRouter (swap models freely) ---
# SAFETRE_LLM=real
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# SAFETRE_MODEL=provider-a/model-small      # or provider-b/model-flash, provider-c/model-chat, ...

# --- Local model (vLLM / Ollama) — the production posture (no data egress) ---
# SAFETRE_LLM=real
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=local
# SAFETRE_MODEL=local-7b-instruct

# --- Disclosure policy overrides (optional) ---
# SAFETRE_MIN_CELL=10
