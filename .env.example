# Copy to .env. Offline (MockLLM) needs none of this.
# The client is OpenAI-compatible, so any of these backends work by config:

# --- OpenRouter (swap models freely) ---
# SAFETRE_LLM=real
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# SAFETRE_MODEL=provider-a/model-small      # or provider-b/model-flash, provider-c/model-chat, ...

# --- Local model (vLLM / Ollama) — the production posture (no data egress) ---
# SAFETRE_LLM=real
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=local
# SAFETRE_MODEL=local-7b-instruct

# --- Disclosure policy overrides (optional) ---
# SAFETRE_MIN_CELL=10

# --- Safepod / restricted-channel controls ---
# In production the app should only accept traffic from the restricted channel
# gateway. For the tailscale-serve topology, the gateway talks to uvicorn over
# localhost, so loopback is the only allowed peer.
# SAFETRE_RESTRICTED_CHANNEL=1
# SAFETRE_CHANNEL_ALLOW_NETS=127.0.0.1/32,::1/128
# SAFETRE_REQUIRE_IDENTITY=1
# SAFETRE_ALLOWLIST=alex@example.org,sam@example.org

# --- Audit log ---
# SAFETRE_AUDIT_DB=/var/lib/safetre/audit.db
# SAFETRE_AUDIT_KEY=load-from-off-box-secret
